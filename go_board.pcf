# ##############################################################################
# go_board.pcf -- Restricciones fisicas de pines
# Nandland Go Board -- Lattice iCE40 HX1K, encapsulado VQ100
#
# Asignaciones tomadas del Go_Board_Constraints.pcf oficial de Nandland.
# Solo se incluyen los pines que usa este proyecto: reloj, 4 botones,
# 4 LEDs y los dos displays de 7 segmentos. UART, VGA y PMOD se omiten.
#
# Uso:
#   yosys -p "synth_ice40 -json calc.json" src/*.v
#   nextpnr-ice40 --hx1k --package vq100 --freq 25 \
#                 --json calc.json --pcf go_board.pcf --asc calc.asc
#   icepack calc.asc calc.bin
#   iceprog calc.bin
# ##############################################################################

### Reloj principal: 25 MHz
set_io i_Clk 15

### Botones
# La correspondencia numero <-> posicion fisica hay que confirmarla en
# la placa. Este proyecto asume:
#   Switch_1 = superior izquierdo  -> incrementar
#   Switch_2 = inferior izquierdo  -> decrementar
#   Switch_3 = superior derecho    -> confirmar
#   Switch_4 = inferior derecho    -> usar resultado anterior
# Si no calza, se reordenan estas cuatro lineas, sin tocar el Verilog.
set_io i_Switch_1 53
set_io i_Switch_2 51
set_io i_Switch_3 54
set_io i_Switch_4 52

### LEDs: codigo de operacion en 1..3, LED_4 encendido en S3
set_io o_LED_1 56
set_io o_LED_2 57
set_io o_LED_3 59
set_io o_LED_4 60

### Display izquierdo: signo (solo el segmento G)
set_io o_Segment1_A 3
set_io o_Segment1_B 4
set_io o_Segment1_C 93
set_io o_Segment1_D 91
set_io o_Segment1_E 90
set_io o_Segment1_F 1
set_io o_Segment1_G 2

### Display derecho: magnitud
set_io o_Segment2_A 100
set_io o_Segment2_B 99
set_io o_Segment2_C 97
set_io o_Segment2_D 95
set_io o_Segment2_E 94
set_io o_Segment2_F 8
set_io o_Segment2_G 96
