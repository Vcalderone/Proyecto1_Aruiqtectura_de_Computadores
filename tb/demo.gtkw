[*]
[*] Sesion de GTKWave para demo.vcd -- evaluacion presencial
[*]
[dumpfile] "demo.vcd"
[savefile] "demo.gtkw"
[timestart] 0
[size] 1600 900
[pos] -1 -1
*-16.0 0 -1 -1 -1 -1 -1 -1
[treeopen] demo_tb.
[sst_width] 260
[signals_width] 200
[sst_expanded] 1
[sst_vpaned_height] 340
@200
-ENTRADAS
@28
demo_tb.op[2:0]
@22
demo_tb.a[3:0]
demo_tb.b[3:0]
@200
-DECODIFICADOR one-hot
@28
demo_tb.sel_rst
demo_tb.sel_add
demo_tb.sel_sub
demo_tb.sel_rsub
demo_tb.sel_shl
demo_tb.sel_shr
@200
-CONTROL
@28
demo_tb.sub
demo_tb.swp
@200
-VIAS INTERNAS
@22
demo_tb.sum[3:0]
demo_tb.shl[3:0]
demo_tb.shr[3:0]
@200
-RESULTADO
@22
demo_tb.r[3:0]
[pattern_trace] 1
[pattern_trace] 0
